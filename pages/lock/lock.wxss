.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.lock-status, .lock-status-empty {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.lock-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.lock-label {
  color: #8c8c8c;
}

.lock-value {
  color: #333333;
  font-weight: 500;
}

.empty-text {
  font-size: 28rpx;
  color: #8c8c8c;
  text-align: center;
  display: block;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input, .picker-view {
  width: 100%;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-view {
  color: #333;
}

.apply-btn, .scan-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.apply-btn {
  background: #fa8c16;
  color: #ffffff;
}

.scan-btn {
  background: #13c2c2;
  color: #ffffff;
}