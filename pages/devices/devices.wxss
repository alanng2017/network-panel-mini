.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.device-icon-container {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.device-icon {
  font-size: 40rpx;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.device-sub {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.device-meta {
  font-size: 22rpx;
  color: #8c8c8c;
  display: block;
  margin-top: 8rpx;
}